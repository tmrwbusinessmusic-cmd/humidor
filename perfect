    catalog.forEach(c => {
      if (searchTerm) {
        if (c.name.toLowerCase().includes(searchTerm.toLowerCase()) || c.brand.toLowerCase().includes(searchTerm.toLowerCase())) {
           if (!groups[c.brand]) groups[c.brand] = [];
           groups[c.brand].push(c);
        }
      } else {
