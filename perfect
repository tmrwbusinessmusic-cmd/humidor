// Helper to pick the right image
const getImageForCigar = (cigar) => {
  const text = (cigar.description + " " + cigar.name + " " + (cigar.shape || "") + " " + (cigar.wrapper || "")).toLowerCase();
  
  if (text.includes("tube") || text.includes("tubo")) return CIGAR_IMAGES.tubo;
  if (text.includes("torpedo") || text.includes("belicoso") || text.includes("pyramid") || text.includes("figurado")) return CIGAR_IMAGES.torpedo;
  if (text.includes("box-pressed") || text.includes("box pressed")) return CIGAR_IMAGES.boxpressed;
  
  if (text.includes("maduro") || text.includes("oscuro") || text.includes("broadleaf") || text.includes("dark") || text.includes("san andres") || text.includes("san andrés")) return CIGAR_IMAGES.maduro;
  if (text.includes("connecticut") || text.includes("shade") || text.includes("champagne") || text.includes("blonde") || text.includes("light") || text.includes("clar")) return CIGAR_IMAGES.connecticut;
  if (text.includes("infused") || text.includes("flavor") || text.includes("acid")) return CIGAR_IMAGES.infused;
  
  if (text.includes("habano") || text.includes("sun grown") || text.includes("rosado") || text.includes("corojo") || text.includes("sumatra")) return CIGAR_IMAGES.habano;
  
  return text.includes("full-bodied") ? CIGAR_IMAGES.generic_dark : CIGAR_IMAGES.generic_light;
};

