export default function App() {
  const [user, setUser] = useState(null);
  const [reviews, setReviews] = useState([]);
  const [loading, setLoading] = useState(true);
  const [searchTerm, setSearchTerm] = useState('');
  
  // Navigation State
  const [currentView, setCurrentView] = useState('vault'); // 'vault' | 'feed' | 'detail'
  const [selectedCigar, setSelectedCigar] = useState(null);
  
  // Modal States
  const [showForm, setShowForm] = useState(false);
  
  // Form State
  const [newReview, setNewReview] = useState({
    brand: '',
    cigarName: '',
    rating: 0,
    notes: '',
    imageUrl: ''
  });
  const [submitting, setSubmitting] = useState(false);

  // 1. Auth Initialization
  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (error) { console.error("Auth error:", error); }
    };
    initAuth();
    return onAuthStateChanged(auth, setUser);
  }, []);

  // 2. Data Fetching
  useEffect(() => {
    if (!user) return;
    const reviewsRef = collection(db, 'artifacts', appId, 'public', 'data', 'reviews');
    return onSnapshot(reviewsRef, (snapshot) => {
      const fetchedReviews = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      fetchedReviews.sort((a, b) => (b.timestamp?.seconds || 0) - (a.timestamp?.seconds || 0));
      setReviews(fetchedReviews);
      setLoading(false);
    }, (error) => { console.error("Firestore error:", error); setLoading(false); });
  }, [user]);

  const handleLoadSamples = async () => {
    if (!user) return;
    setSubmitting(true);
    try {
      const reviewsRef = collection(db, 'artifacts', appId, 'public', 'data', 'reviews');
      await Promise.all(SAMPLE_REVIEWS.map(review => addDoc(reviewsRef, { ...review, userId: user.uid, timestamp: serverTimestamp() })));
    } catch (error) { console.error("Error loading samples:", error); } finally { setSubmitting(false); }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    if (!newReview.brand || !newReview.cigarName || newReview.rating === 0) return;
    setSubmitting(true);
    try {
      await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'reviews'), { ...newReview, userId: user.uid, timestamp: serverTimestamp() });
      setNewReview({ brand: '', cigarName: '', rating: 0, notes: '', imageUrl: '' });
      setShowForm(false);
    } catch (error) { console.error("Error adding review:", error); } finally { setSubmitting(false); }
  };

  const handleDelete = async (reviewId) => {
    try { await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'reviews', reviewId)); } catch (error) { console.error("Error deleting:", error); }
  };

  const openReviewForm = (item) => {
    setNewReview({ 
      brand: item.brand, 
      cigarName: item.name, 
      rating: 0, 
      notes: '', 
      imageUrl: item.imageUrl || getImageForCigar(item)
    });
    setShowForm(true);
  };
  
  const handleSelectCigar = (item) => {
    setSelectedCigar(item);
    setCurrentView('detail');
  };

  const handleBackToVault = () => {
    setSelectedCigar(null);
    setCurrentView('vault');
  };

  // Filter feed for Feed View
  const filteredReviews = useMemo(() => reviews.filter(r => r.cigarName.toLowerCase().includes(searchTerm.toLowerCase()) || r.brand.toLowerCase().includes(searchTerm.toLowerCase())), [reviews, searchTerm]);

  // --- Render ---

  return (
    <div className="min-h-screen bg-stone-950 text-stone-200 font-sans selection:bg-amber-900 selection:text-amber-100">
      
      {/* Navigation Header */}
      <nav className="bg-stone-950 border-b border-amber-900/20 sticky top-0 z-50 backdrop-blur-xl bg-opacity-90">
        <div className="max-w-6xl mx-auto px-4">
          <div className="flex justify-between items-center h-16">
            {/* Logo */}
            <div className="flex items-center gap-3 cursor-pointer" onClick={() => setCurrentView('vault')}>
              <div className="bg-gradient-to-br from-amber-600 to-amber-800 p-2 rounded-lg shadow-lg shadow-amber-900/30">
                <Flame className="text-stone-950 fill-stone-950" size={20} />
              </div>
              <div>
                <h1 className="text-xl font-serif font-bold text-amber-100 tracking-tight leading-none">The Humidor</h1>
                <p className="text-[10px] text-amber-600/80 uppercase tracking-[0.2em] font-bold">Aficionado Vault</p>
              </div>
            </div>

            {/* Nav Links */}
            <div className="flex items-center gap-1 bg-stone-900/50 p-1 rounded-full border border-stone-800">
               <button 
                onClick={() => setCurrentView('vault')}
                className={`px-4 py-1.5 rounded-full text-sm font-medium transition-all ${currentView === 'vault' || currentView === 'detail' ? 'bg-stone-800 text-amber-100 shadow-sm border border-stone-700' : 'text-stone-500 hover:text-stone-300'}`}
               >
                 The Vault
               </button>
               <button 
                onClick={() => setCurrentView('feed')}
                className={`px-4 py-1.5 rounded-full text-sm font-medium transition-all ${currentView === 'feed' ? 'bg-stone-800 text-amber-100 shadow-sm border border-stone-700' : 'text-stone-500 hover:text-stone-300'}`}
               >
                 Community Feed
               </button>
            </div>
          </div>
        </div>
      </nav>

      {/* Main Content Switcher */}
      <main className="min-h-[calc(100vh-64px)]">
        
        {/* 1. VAULT VIEW */}
        {(currentView === 'vault') && (
          <div className="max-w-6xl mx-auto px-4 py-8">
            <div className="flex flex-col md:flex-row justify-between items-end mb-8 gap-4">
              <div>
                <h2 className="text-3xl font-serif font-bold text-amber-100 mb-2">Cigar Vault</h2>
                <p className="text-stone-400 max-w-xl">Browse our curated database of premium cigars. Select a cigar to view its detailed profile, flavor accords, and community ratings.</p>
              </div>
              <div className="relative w-full md:w-64">
                <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"><Search className="text-stone-600" size={16} /></div>
                <input 
                  type="text" 
                  placeholder="Find a cigar..." 
                  className="w-full bg-stone-900 border border-stone-800 rounded-lg py-2 pl-9 pr-4 text-stone-200 focus:outline-none focus:border-amber-800 transition-colors text-sm"
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                />
              </div>
            </div>
            <VaultView catalog={CIGAR_CATALOG} onSelect={handleSelectCigar} searchTerm={searchTerm} />
          </div>
        )}

        {/* 2. DETAIL VIEW */}
        {(currentView === 'detail' && selectedCigar) && (
           <CigarDetailPage 
             cigar={selectedCigar} 
             onBack={handleBackToVault}
             onWriteReview={openReviewForm}
             allReviews={reviews}
           />
        )}

        {/* 3. FEED VIEW */}
        {(currentView === 'feed') && (
          <div className="max-w-3xl mx-auto px-4 py-8">
            <div className="flex justify-between items-center mb-6">
               <h2 className="text-2xl font-serif font-bold text-amber-100">Community Board</h2>
               <button 
                onClick={() => { setNewReview({brand:'',cigarName:'',rating:0,notes:'',imageUrl:''}); setShowForm(true); }} 
                className="bg-amber-700 hover:bg-amber-600 text-white px-4 py-2 rounded-lg text-sm font-bold flex items-center gap-2 shadow-lg shadow-amber-900/20 transition-all"
               >
                 <PlusCircle size={16} /> Post Review
               </button>
            </div>
            
            <div className="space-y-6">
              {loading ? (
                <div className="text-center py-20 text-stone-500"><Loader2 className="animate-spin mx-auto mb-2" /> Loading...</div>
              ) : filteredReviews.length === 0 ? (
                 <div className="text-center py-20 bg-stone-900 rounded-xl border border-stone-800 border-dashed">
                    <p className="text-stone-500">No reviews yet. Be the first!</p>
                 </div>
              ) : (
                filteredReviews.map(review => (
                  <ReviewCard key={review.id} review={review} isOwner={user && user.uid === review.userId} onDelete={handleDelete} />
                ))
              )}
            </div>
            
            {/* Expert Picks Loader */}
            <div className="mt-12 text-center border-t border-stone-800 pt-8">
              <button 
                onClick={handleLoadSamples} 
                disabled={submitting || !user} 
                className="text-stone-600 hover:text-amber-600 text-xs uppercase tracking-widest font-bold flex items-center justify-center gap-2 mx-auto transition-colors disabled:opacity-50"
              >
                 <DownloadCloud size={14} /> Load Expert Picks
              </button>
            </div>
          </div>
        )}
      </main>

      {/* Global Review Form Modal */}
      {showForm && (
        <div className="fixed inset-0 z-[70] flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200">
           <div className="bg-stone-900 border border-amber-900/30 rounded-2xl p-6 md:p-8 shadow-2xl relative overflow-hidden max-w-lg w-full ring-1 ring-white/10">
              <div className="absolute -top-20 -right-20 w-64 h-64 bg-amber-600/10 rounded-full blur-3xl pointer-events-none"></div>
              
              <div className="flex justify-between items-start mb-6">
                 <h2 className="text-2xl font-serif text-amber-100 flex items-center gap-2">
                    <Cigarette className="text-amber-600" size={24} /> 
                    {newReview.cigarName ? 'Review Cigar' : 'New Review'}
                 </h2>
                 <button onClick={() => setShowForm(false)} className="text-stone-500 hover:text-stone-200"><X size={20} /></button>
              </div>

              <form onSubmit={handleSubmit} className="space-y-4">
                {!newReview.cigarName && (
                   <div className="grid grid-cols-2 gap-4">
                    <div className="space-y-1.5"><label className="text-[10px] font-bold text-stone-500 uppercase tracking-wider">Brand</label><input required type="text" className="w-full bg-stone-800 border border-stone-700 rounded-lg px-3 py-2 focus:outline-none focus:border-amber-600 text-stone-200 text-sm" value={newReview.brand} onChange={(e) => setNewReview({...newReview, brand: e.target.value})} /></div>
                    <div className="space-y-1.5"><label className="text-[10px] font-bold text-stone-500 uppercase tracking-wider">Cigar Name</label><input required type="text" className="w-full bg-stone-800 border border-stone-700 rounded-lg px-3 py-2 focus:outline-none focus:border-amber-600 text-stone-200 text-sm" value={newReview.cigarName} onChange={(e) => setNewReview({...newReview, cigarName: e.target.value})} /></div>
                  </div>
                )}
                
                {newReview.cigarName && (
                  <div className="bg-stone-800/50 p-3 rounded-lg border border-stone-800 mb-2">
                     <p className="text-amber-500 text-xs font-bold uppercase">{newReview.brand}</p>
                     <p className="text-stone-200 font-serif font-bold text-lg">{newReview.cigarName}</p>
                  </div>
                )}

                 <div className="space-y-1.5">
                  <label className="text-[10px] font-bold text-stone-500 uppercase tracking-wider">Rating</label>
                  <div className="bg-stone-800 border border-stone-700 rounded-lg p-3 flex justify-center"><StarRating rating={newReview.rating} setRating={(r) => setNewReview({...newReview, rating: r})} editable size={32} /></div>
                </div>
                 <div className="space-y-1.5"><label className="text-[10px] font-bold text-stone-500 uppercase tracking-wider">Notes</label><textarea required rows="4" placeholder="Flavor notes, burn quality, pairing..." className="w-full bg-stone-800 border border-stone-700 rounded-lg px-3 py-2 focus:outline-none focus:border-amber-600 text-stone-200 text-sm resize-none" value={newReview.notes} onChange={(e) => setNewReview({...newReview, notes: e.target.value})}></textarea></div>
                
                <button type="submit" disabled={submitting || newReview.rating === 0} className="w-full bg-amber-700 hover:bg-amber-600 text-white py-3 rounded-lg font-bold flex items-center justify-center gap-2 mt-2 transition-all disabled:opacity-50 disabled:cursor-not-allowed shadow-lg">
                  {submitting ? <Loader2 className="animate-spin" size={18} /> : 'Post Review'}
                </button>
              </form>
           </div>
        </div>
      )}

    </div>
  );
}
