const generateAccords = (description) => {
  const text = description.toLowerCase();
  const potentialAccords = [
    { label: "Earth", color: "bg-amber-950", text: "text-amber-100", keywords: ["earth", "dirt", "soil", "peat", "dark", "heavy"] },
    { label: "Spice", color: "bg-red-800", text: "text-red-100", keywords: ["spice", "pepper", "spicy", "cinnamon", "cumin", "saffron", "kick"] },
    { label: "Wood", color: "bg-amber-700", text: "text-amber-100", keywords: ["wood", "cedar", "oak", "woody", "pine", "hickory"] },
    { label: "Cocoa", color: "bg-stone-800", text: "text-stone-200", keywords: ["cocoa", "chocolate", "espresso", "coffee", "mocha", "bean"] },
    { label: "Sweet", color: "bg-orange-700", text: "text-orange-100", keywords: ["sweet", "sugar", "fruit", "cherry", "raisin", "caramel", "vanilla", "honey", "maple"] },
    { label: "Cream", color: "bg-yellow-100", text: "text-yellow-900", keywords: ["cream", "butter", "milk", "smooth", "velvety"] },
    { label: "Leather", color: "bg-stone-600", text: "text-stone-100", keywords: ["leather", "animal", "tanned"] },
    { label: "Nutty", color: "bg-amber-200", text: "text-amber-900", keywords: ["nut", "almond", "walnut", "cashew", "peanut", "chestnut"] },
    { label: "Herbal", color: "bg-green-800", text: "text-green-100", keywords: ["grass", "hay", "tea", "floral", "herb", "mint"] },
  ];

  let foundAccords = potentialAccords.filter(accord => 
    accord.keywords.some(k => text.includes(k))
  );

  if (foundAccords.length < 2) {
    foundAccords.push({ label: "Tobacco", color: "bg-amber-800", text: "text-amber-100", keywords: [] });
  }
  
  return foundAccords.map((acc, i) => ({
    ...acc,
    width: Math.max(20, 100 - (i * 15)) + '%'
  }));
};

const generateStats = (cigar) => {
  const desc = cigar.description.toLowerCase();
  let strength = 50; 
  
  if (desc.includes('full-bodied') || desc.includes('strong') || desc.includes('powerhouse') || desc.includes('intense')) {
    strength = 85;
  } else if (desc.includes('medium-to-full') || desc.includes('medium to full')) {
    strength = 70;
  } else if (desc.includes('mild-to-medium') || desc.includes('mild to medium')) {
    strength = 35;
  } else if (desc.includes('mild') || desc.includes('smooth') || desc.includes('creamy')) {
    strength = 20;
  }

  const nameHash = cigar.name.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const draw = 60 + (nameHash % 30); 
  const burn = 70 + (nameHash % 25);

  return { strength, draw, burn };
};

